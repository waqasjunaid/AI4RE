        "User is logged in",
        "Shell is running"
      ],
      "steps": [
        "User types command and presses enter",
        "Shell reads input and divides into words and operators",
        "Shell executes command"
      ],
      "postconditions": [
        "Command is executed successfully"
      ],
      "exceptions": [
        "Invalid command syntax"
      ]
    },
    {
