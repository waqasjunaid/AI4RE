      "threshold": null,
      "source_ids": [
        "auth_system_srs"
      ]
    },
    {
      "constraint_id": "NFR-003",
      "category": "security",
      "description": "Client-server communication must use TLS 1.2 or higher",
      "threshold": null,
      "source_ids": [
        "auth_system_srs"
      ]
    }
  ],
  "runtime_constraints": [
    {
      "constraint_id": "RT-001",
      "description": "Access tokens expire 15 minutes after issuance",
      "affects_reqs": [
        "token renewal"
      ],
      "source_ids": [
        "auth_system_srs"
      ]
    },
    {
      "constraint_id": "RT-002",
      "description": "Invalid submitted credentials",
      "affects_reqs": [
        "login",
        "authentication"
      ],
      "source_ids": [
        "auth_system_srs"
      ]
    },
    {
      "constraint_id": "RT-003",
      "description": "5 consecutive failed login attempts",
      "affects_reqs": [
        "login",
        "account locking"
      ],
      "source_ids": [
        "auth_system_srs"
      ]
    },
    {
      "constraint_id": "RT-004",
      "description": "15 minutes to unlock account",
      "affects_reqs": [
        "account unlocking"
      ],
      "source_ids": [
        "auth_system_srs"
      ]
    },
    {
      "constraint_id": "RT-005",
      "description": "10 requests per minute per client IP address",
      "affects_reqs": [
        "rate limiting",
        "API usage"
      ],
      "source_ids": [
        "auth_system_srs"
      ]
    }
  ],
