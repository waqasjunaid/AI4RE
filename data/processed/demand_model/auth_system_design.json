{
  "source_id": "auth_system_design",
  "bundle_id": "auth_system",
  "system_objectives": [
    "isExpired()",
    "refresh()",
    "invalidate()",
    "validateCredentials",
    "enableMFA",
    "lockAccount",
    "validate AuthRequest",
    "LOGIN_SUCCESS"
  ],
  "user_roles": [
    "User",
    "Client",
    "AuthController",
    "TokenService",
    "AuditLog",
    "SessionStore",
    "UserDB",
    "AuthService",
    "AuditDB",
    "Browser"
  ],
  "use_cases": [
    {
      "use_case_id": "UC-001",
      "actor": "User",
      "goal": "Login to the system",
      "preconditions": [
        "User has a valid email and password"
      ],
      "steps": [
        "User sends AuthRequest to AuthController",
        "AuthController validates AuthRequest",
        "AuthService verifies user credentials"
      ],
      "postconditions": [
        "User is logged in",
        "SessionStore contains user session"
      ],
      "exceptions": [
        "LOGIN_FAILURE"
      ]
    },
    {
      "use_case_id": "UC-002",
      "actor": "User",
      "goal": "Change password",
      "preconditions": [
        "User is logged in"
      ],
      "steps": [
        "User sends new password to AuthController",
        "AuthService verifies old password",
        "AuthService updates user password"
      ],
      "postconditions": [
        "User password is updated",
        "AuditLog records PASSWORD_CHANGE event"
      ],
      "exceptions": []
    },
    {
      "use_case_id": "UC-003",
      "actor": "Client",
      "goal": "Refresh token",
      "preconditions": [
        "Client has a valid refresh token"
      ],
      "steps": [
        "Client sends refresh token to TokenService",
        "TokenService verifies refresh token",
        "TokenService generates new token pair"
      ],
      "postconditions": [
        "Client receives new token pair",
        "AuditLog records TOKEN_REFRESH event"
      ],
      "exceptions": []
    },
    {
      "use_case_id": "UC-004",
      "actor": "User",
      "goal": "Enable MFA",
      "preconditions": [
        "User is logged in"
      ],
      "steps": [
        "User sends request to enable MFA to AuthController",
        "AuthService enables MFA for user"
      ],
      "postconditions": [
        "MFA is enabled for user",
        "AuditLog records MFA_ENABLED event"
      ],
      "exceptions": []
    },
    {
      "use_case_id": "UC-005",
      "actor": "AuthController",
      "goal": "Lock account after multiple login failures",
      "preconditions": [
        "Multiple LOGIN_FAILURE events occur"
      ],
      "steps": [
        "AuthController detects multiple login failures",
        "AuthService locks user account"
      ],
      "postconditions": [
        "User account is locked",
        "AuditLog records ACCOUNT_LOCKED event"
      ],
      "exceptions": []
    },
    {
      "use_case_id": "UC-006",
      "actor": "User",
      "goal": "Logout from the system",
      "preconditions": [
        "User is logged in"
      ],
      "steps": [
        "User sends logout request to AuthController",
        "AuthService invalidates user session"
      ],
      "postconditions": [
        "User is logged out",
        "AuditLog records LOGOUT event"
      ],
      "exceptions": []
    },
    {
      "use_case_id": "UC-007",
      "actor": "AuthController",
      "goal": "Validate AuthRequest",
      "preconditions": [
        "AuthRequest is received"
      ],
      "steps": [
        "AuthController validates AuthRequest"
      ],
      "postconditions": [
        "AuthRequest is valid or invalid"
      ],
      "exceptions": []
    },
    {
      "use_case_id": "UC-008",
      "actor": "AuthService",
      "goal": "Verify user credentials",
      "preconditions": [
        "User credentials are provided"
      ],
      "steps": [
        "AuthService verifies user password"
      ],
      "postconditions": [
        "User credentials are valid or invalid"
      ],
      "exceptions": []
    },
    {
      "use_case_id": "UC-009",
      "actor": "TokenService",
      "goal": "Generate token pair for user",
      "preconditions": [
        "User ID is provided"
      ],
      "steps": [
        "TokenService generates token pair"
      ],
      "postconditions": [
        "Token pair is generated"
      ],
      "exceptions": []
    },
    {
      "use_case_id": "UC-010",
      "actor": "AuditLog",
      "goal": "Record event",
      "preconditions": [
        "Event ID is provided"
      ],
      "steps": [
        "AuditLog records event"
      ],
      "postconditions": [
        "Event is recorded"
      ],
      "exceptions": []
    }
  ],
  "functional_reqs": [
    {
      "req_id": "FR-001",
      "description": "The system shall validate the AuthRequest to ensure it conforms to the expected format and content.",
      "source_ids": [
        "auth_system_design"
      ],
      "priority": "high"
    },
    {
      "req_id": "FR-002",
      "description": "The system shall determine if a token or session has expired using the isExpired() function.",
      "source_ids": [
        "auth_system_design"
      ],
      "priority": "medium"
    },
    {
      "req_id": "FR-003",
      "description": "The system shall refresh an existing token or session when requested using the refresh() function.",
      "source_ids": [
        "auth_system_design"
      ],
      "priority": "high"
    },
    {
      "req_id": "FR-004",
      "description": "The system shall invalidate a token or session when requested using the invalidate() function.",
      "source_ids": [
        "auth_system_design"
      ],
      "priority": "medium"
    },
    {
      "req_id": "FR-005",
      "description": "The system shall validate user credentials to ensure they match stored values.",
      "source_ids": [
        "auth_system_design"
      ],
      "priority": "high"
    },
    {
      "req_id": "FR-006",
      "description": "The system shall enable multi-factor authentication (MFA) for a user account when requested using the enableMFA function.",
      "source_ids": [
        "auth_system_design"
      ],
      "priority": "medium"
    },
    {
      "req_id": "FR-007",
      "description": "The system shall lock a user account after a specified number of failed login attempts or when requested using the lockAccount function.",
      "source_ids": [
        "auth_system_design"
      ],
      "priority": "high"
    },
    {
      "req_id": "FR-008",
      "description": "The system shall return a LOGIN_SUCCESS event upon successful authentication.",
      "source_ids": [
        "auth_system_design"
      ],
      "priority": "medium"
    },
    {
      "req_id": "FR-009",
      "description": "The system shall return a LOGIN_FAILURE event upon failed authentication.",
      "source_ids": [
        "auth_system_design"
      ],
      "priority": "medium"
    },
    {
      "req_id": "FR-010",
      "description": "The system shall generate a PASSWORD_CHANGE event when a user's password is changed.",
      "source_ids": [
        "auth_system_design"
      ],
      "priority": "low"
    }
  ],
  "nfr_constraints": [
    {
      "constraint_id": "NFR-004",
      "category": "security",
      "description": "Password must contain uppercase, lowercase, digit, symbol",
      "threshold": null,
      "source_ids": [
        "auth_system_design"
      ]
    },
    {
      "constraint_id": "NFR-006",
      "category": "security",
      "description": "All tokens must be signed with RS256 (asymmetric)",
      "threshold": null,
      "source_ids": [
        "auth_system_design"
      ]
    },
    {
      "constraint_id": "NFR-008",
      "category": "compatibility",
      "description": "TLS 1.2 minimum for all connections",
      "threshold": null,
      "source_ids": [
        "auth_system_design"
      ]
    }
  ],
  "runtime_constraints": [
    {
      "constraint_id": "RT-001",
      "description": "Max failed login attempts: 5 before lock",
      "affects_reqs": [
        "login"
      ],
      "source_ids": [
        "auth_system_design"
      ]
    },
    {
      "constraint_id": "RT-002",
      "description": "Account lock duration: 30 minutes",
      "affects_reqs": [
        "login",
        "account management"
      ],
      "source_ids": [
        "auth_system_design"
      ]
    },
    {
      "constraint_id": "RT-003",
      "description": "Session store TTL: aligned with refresh token TTL",
      "affects_reqs": [
        "session management"
      ],
      "source_ids": [
        "auth_system_design"
      ]
    }
  ],
  "glossary": {
    "EventType": "EventType",
    "AccountStatus": "AccountStatus",
    "accessToken": "accessToken",
    "refreshToken": "refreshToken",
    "expiresIn": "expiresIn",
    "tokenType": "tokenType",
    "ACTIVE": "ACTIVE",
    "LOCKED": "LOCKED",
    "SUSPENDED": "SUSPENDED",
    "PENDING_VERIFICATION": "PENDING_VERIFICATION",
    "LoginFlow": "LoginFlow"
  },
  "exception_handlers": []
}